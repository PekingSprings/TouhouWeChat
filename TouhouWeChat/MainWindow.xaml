<Window x:Class="TouhouWeChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:local="clr-namespace:TouhouWeChat"
        mc:Ignorable="d"
        Title="TouhouWeChat" Height="600" Width="1000"
        Icon="icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：角色列表 -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#22000000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0">
                        <StackPanel>
                            
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="CharacterList" SelectionChanged="Selected_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 头像 -->
                                    <Border Grid.Column="0"
                                            Width="44" Height="44"
                                            CornerRadius="8"
                                            Background="#33000000"
                                            Margin="0,0,10,0">
                                        <Image Source="{Binding AvatarImage}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- 名字 + 消息预览 -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Displayname}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- ~1~ <TextBlock Text="{Binding persondescription}" @1@ -->
                                        <!--            FontSize="11" -->
                                        <!--            Foreground="#888888" -->
                                        <!--            TextTrimming="CharacterEllipsis" -->
                                        <!--            Margin="0,3,0,0"/> -->
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </Grid>
            </Border>
            <!-- 右：聊天区 -->
            <Border Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"  BorderThickness="0,0,1,0"
                            BorderBrush="#22000000">
                        <Grid>
                            <TextBlock x:Name="DisplayNameText"
                                       Text="未选择"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="20,0"/>

                            <Button x:Name="ClearHistoryButton"
                                    Content="🗑️"
                                    FontSize="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,20,0"
                                    Padding="12,6"
                                    Click="ClearHistory_Click"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1">
                        <ScrollViewer
                                      x:Name="ChatScroll"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MessageList" Margin="16,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Bubble"
                                                Margin="0,4"
                                                Padding="12,8"
                                                CornerRadius="10"
                                                Background="#2A2A2A"
                                                HorizontalAlignment="Left"
                                                MaxWidth="480">
                                            <TextBlock Text="{Binding Content}"
                                                       TextWrapping="Wrap"
                                                       Foreground="White"/>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Bubble" Property="Background" Value="#0066CC"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="2" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox"
                                 Grid.Column="0"
                                 MinHeight="80"
                                 Padding="10,6"
                                 VerticalContentAlignment="Center"
                                 AcceptsReturn="False"
                                 KeyDown="InputBox_KeyDown"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Enter"
                                MinWidth="80"
                                MinHeight="80"
                                Margin="6,0,0,0"
                                Click="SendButton_ClickAndAIreply"/>
                    </Grid>
                   
                    
                </Grid>
            </Border>
        
    </Grid>
</Window>
